# ─────────────────────────────────────────────────────────────
# AcademiaSentinel — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Frontend (Vite — must be prefixed VITE_) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key    # Safe to expose in client bundle (RLS enforced)

# ── Netlify Functions (backend — NO VITE_ prefix) ─────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key         # Used to verify user JWTs in _auth.js
SUPABASE_SERVICE_KEY=your-service-role-key  # NEVER expose to client — backend only

GROQ_API_KEY=gsk_your-groq-key          # Required: AI classification + report gen

HIBP_API_KEY=your-hibp-key              # Optional: HaveIBeenPwned domain breach check
GOOGLE_CSE_KEY=your-cse-key             # Optional: Google Custom Search for paste sites
GOOGLE_CSE_ID=your-cse-id              # Optional

# ── Security ──────────────────────────────────────────────────
SITE_ORIGIN=https://your-site.netlify.app   # Your deployed URL — restricts CORS

# ── Netlify auto-provides (do not set manually) ───────────────
# URL=https://your-site.netlify.app      # Auto-set by Netlify
